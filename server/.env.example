
# Server Configuration
PORT= #

# MongoDB Configuration
MONGO_URI_Local=mongodb://localhost:27017/fyp-db
MONGO_URI= #

# JWT Configuration
JWT_SECRET= #
JWT_EXPIRES_IN=1h
REFRESH_JWT_SECRET=#
