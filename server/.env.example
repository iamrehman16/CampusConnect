# ---------------------------------------------------------------------------
# Environment contract (BACKLOG.md I2). The server validates this at boot
# (src/config/env.validation.ts) and refuses to start when a required
# variable is missing. R = required, o = optional, - = unused.
#
# Variable                         local  demo/prod  Notes
# NODE_ENV                         R      R          `production` selects MONGO_URI
# JWT_SECRET, REFRESH_JWT_SECRET   R      R
# MONGO_URI_Local                  R      -          local/dev Mongo
# MONGO_URI                        -      R          Atlas; demo uses the `campusconnect_demo` database
# FRONTEND_URL                     o      R          bare origin, no trailing slash: CORS + Google redirect
# GROQ_API_KEY                     R*     R          *AI chat only
# GEMINI_API_KEY                   R*     R          *embeddings / RAG only
# QDRANT_URL, QDRANT_API_KEY       R*     R          *RAG only; demo cluster is the eu-central-1 one
# QDRANT_COLLECTION_SUFFIX         o      `_demo`    isolates collections on a shared cluster
# LLAMA_CLOUD_API_KEY              R*     R          *document ingestion only
# CLOUDINARY_*                     R*     R          *uploads only
# CLIENT_ID, CLIENT_SECRET,
#   GOOGLE_CALLBACK_URL            o      o          without them Google sign-in answers 503 (warned at boot)
#
# `*` = needed for that feature locally, but only enforced at boot in production.
# Client (client/.env.example): VITE_API_BASE_URL is the server ORIGIN, no `/api`.
# ---------------------------------------------------------------------------


# Server Configuration
PORT= #

# MongoDB Configuration
MONGO_URI_Local=mongodb://localhost:27017/fyp-db
MONGO_URI= #

# JWT Configuration
JWT_SECRET= #
JWT_EXPIRES_IN=1h
REFRESH_JWT_SECRET=#
REFRESH_JWT_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME= #
CLOUDINARY_API_KEY= #
CLOUDINARY_API_SECRET= #

# Groq API Configuration
GROQ_API_KEY= #
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_PROMPT_TOKENS=6000

# CORS Configuration (for frontend connection)
FRONTEND_URL= #

#QDrant Configurations

QDRANT_API_KEY= #
QDRANT_URL= #
QDRANT_COLLECTION_SUFFIX= # optional, e.g. _dev or _demo; isolates collections per environment on a shared cluster

#Gemini Configurations

GEMINI_API_KEY= #
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

#Llama Parse Configuration
LLAMA_CLOUD_API_KEY= #

# The Switch
NODE_ENV=development

# GOOGLE OAUTH (any Google account may sign in)
CLIENT_ID= # OAuth client id
CLIENT_SECRET= # OAuth client secret
GOOGLE_CALLBACK_URL=http://localhost:3100/api/auth/google/callback # must match the redirect URI registered in Google Cloud