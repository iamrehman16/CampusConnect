# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME= #
CLOUDINARY_API_KEY= #
CLOUDINARY_API_SECRET= #

# Groq API Configuration
GROQ_API_KEY= #
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_PROMPT_TOKENS=6000

# CORS Configuration (for frontend connection)
FRONTEND_URL= #

#QDrant Configurations

QDRANT_API_KEY= #
QDRANT_URL= #
QDRANT_COLLECTION_SUFFIX= # optional, e.g. _dev or _demo; isolates collections per environment on a shared cluster

#Gemini Configurations

GEMINI_API_KEY= #
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

#Llama Parse Configuration
LLAMA_CLOUD_API_KEY= #

#Redis COnfiguration
REDIS_LOCAL_URL=redis://localhost:6379
REDIS_UPSTASH_URL= #
BULL_PREFIX= # optional, default 'bull'; set per environment when several share one Redis

# The Switch
NODE_ENV=development